# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Данные для отбора фото и чтения карты (DESIGN.md §1, §8): снимки Google в полном размере,
# среди них фото гостей с лицами и тики (номер счёта, CIF) — в публичный репозиторий не идут;
# восстанавливаются по ссылкам из _data/maps/all-photos.json (`_data/scripts/dl-all.mjs`, `=s0`).
/_data/photos/
/_data/orig/
/_data/crops/
/_data/photo-sheets/*.jpg
/_data/maps/*.jpg
/_data/ig/img/
/_data/*.jpg
/_data/*.png
# Сырые страницы (сотни КБ разметки; разобранное лежит рядом в JSON).
/_data/web/*.html
/_data/serve/
/_data/preview/
# Сырые выгрузки Google с полными именами авторов отзывов и ответами (DESIGN.md §1) — только локально;
# в репозитории — обезличенная копия _data/maps/reviews-public.json (`_data/scripts/sanitize-reviews.mjs`).
/_data/maps/reviews-*.json
!/_data/maps/reviews-public.json
/_data/maps/reviews-all.json
/_data/maps/search-reviews-*.json
/_data/maps/*.txt
/_data/maps/*.log
/_data/menu-text/review-EN.json.bak
